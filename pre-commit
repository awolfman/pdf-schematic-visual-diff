#!/usr/bin/env bash
set -u
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    printf '[pre-commit] Ошибка: каталог не является Git-репозиторием.\n' >&2
    exit 2
}

cd "$REPO_ROOT" || {
    printf '[pre-commit] Ошибка: не удалось перейти в корень репозитория.\n' >&2
    exit 2
}

HOOK_DIR="$REPO_ROOT/.git/hooks"
TOOLS_DIR="$REPO_ROOT/tools"

PDF_HOOK="$TOOLS_DIR/pdf-diff.sh"
CADENCE_HOOK="$TOOLS_DIR/check_cadence_netlist.sh"
BACKEND_FILE="$REPO_ROOT/.schematic-backend"

fail() {
    printf '[pre-commit] Ошибка: %s\n' "$*" >&2
    exit 2
}

[[ -x "$PDF_HOOK" ]] || fail "не найден исполняемый PDF-хук: $PDF_HOOK"
[[ -x "$CADENCE_HOOK" ]] || fail "не найден исполняемый Cadence-хук: $CADENCE_HOOK"

backend="pdf"

if [[ -e "$BACKEND_FILE" ]]; then
    [[ -f "$BACKEND_FILE" ]] || \
        fail "файл режима не является обычным файлом: $BACKEND_FILE"

    mapfile -t backend_lines < "$BACKEND_FILE" || \
        fail "не удалось прочитать файл режима: $BACKEND_FILE"

    backend=""
    for line in "${backend_lines[@]}"; do
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"

        [[ -z "$line" ]] && continue
        [[ "$line" == \#* ]] && continue

        if [[ -z "$backend" ]]; then
            backend="$line"
        else
            fail "в файле режима разрешена только одна непустая строка"
        fi
    done

    [[ -n "$backend" ]] || \
        fail "файл режима не содержит значения: $BACKEND_FILE"
fi

case "$backend" in
    pdf)
        ;;
    cadence)
        ;;
    *)
        fail "неподдерживаемый режим: $backend. Разрешены pdf и cadence"
        ;;
esac

printf '[pre-commit] Режим: %s\n' "$backend"

"$PDF_HOOK"
pdf_status=$?

if [[ "$pdf_status" -ne 0 ]]; then
    printf '[pre-commit] PDF-проверка отклонена.\n' >&2
    exit "$pdf_status"
fi

printf '[pre-commit] PDF-проверка пройдена.\n'

if [[ "$backend" == "pdf" ]]; then
    printf '[pre-commit] Структурная проверка нетлиста отключена.\n'
    exit 0
fi

"$CADENCE_HOOK"
cadence_status=$?

if [[ "$cadence_status" -ne 0 ]]; then
    printf '[pre-commit] Проверка Cadence-нетлиста отклонена.\n' >&2
    exit "$cadence_status"
fi

printf '[pre-commit] PDF и Cadence-проверка пройдены.\n'
exit 0
